{
  "name": "deckrecall",
  "version": "0.4.5",
  "private": true,
  "author": "Ren-Amamiya-pixle",
  "description": "SteamOS Decky plugin for safe game-state snapshots and Proton EXE onboarding",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test:frontend": "tsx --test tests/*.test.ts",
    "test:backend": "python3 -m unittest discover -s tests -v",
    "test": "npm run test:frontend && npm run test:backend",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ren-Amamiya-pixle/DeckRecall.git"
  },
  "homepage": "https://github.com/Ren-Amamiya-pixle/DeckRecall#readme",
  "bugs": { "url": "https://github.com/Ren-Amamiya-pixle/DeckRecall/issues" },
  "keywords": ["decky", "steamos", "steam-deck", "snapshot", "rollback"],
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.53.3",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2"
  },
  "pnpm": { "peerDependencyRules": { "ignoreMissing": ["react", "react-dom"] } }
}
